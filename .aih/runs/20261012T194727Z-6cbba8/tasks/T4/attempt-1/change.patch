diff --git a/tests/middleware/test_shared_data.py b/tests/middleware/test_shared_data.py
index 26e64645..fb87fb9e 100644
--- a/tests/middleware/test_shared_data.py
+++ b/tests/middleware/test_shared_data.py
@@ -1,11 +1,63 @@
 import os
 from contextlib import closing
 
+import pytest
+
+from werkzeug.datastructures import Headers
 from werkzeug.middleware.shared_data import SharedDataMiddleware
 from werkzeug.test import create_environ
 from werkzeug.test import run_wsgi_app
 
 
+def _run(app, path, **kwargs):
+    app_iter, status, headers = run_wsgi_app(app, create_environ(path, **kwargs))
+
+    with closing(app_iter) as app_iter:
+        data = b"".join(app_iter)
+
+    return status, Headers(headers), data
+
+
+def _make_app(tmp_path, **kwargs):
+    (tmp_path / "data.txt").write_text("0123456789")
+    return SharedDataMiddleware(None, {"/s": str(tmp_path)}, **kwargs)
+
+
+def test_conditional_and_range(tmp_path):
+    app = _make_app(tmp_path)
+    status, headers, data = _run(app, "/s/data.txt")
+    assert status == "200 OK"
+    assert data == b"0123456789"
+    assert "max-age" not in headers["Cache-Control"]
+    assert headers["Accept-Ranges"] == "bytes"
+    etag = headers["ETag"]
+
+    status, headers, data = _run(
+        app, "/s/data.txt", headers={"If-None-Match": etag}
+    )
+    assert status == "304 Not Modified"
+    assert data == b""
+
+    status, headers, data = _run(app, "/s/data.txt", headers={"Range": "bytes=2-4"})
+    assert status == "206 Partial Content"
+    assert data == b"234"
+    assert headers["Content-Range"] == "bytes 2-4/10"
+
+
+def test_cache_timeout(tmp_path):
+    app = _make_app(tmp_path, cache_timeout=60)
+    _, headers, _ = _run(app, "/s/data.txt")
+    assert "max-age=60" in headers["Cache-Control"]
+
+
+@pytest.mark.parametrize(
+    "kwargs", [{"cache": False}, {"fallback_mimetype": "text/plain"}]
+)
+def test_deprecated_parameters(tmp_path, kwargs):
+    with pytest.deprecated_call():
+        SharedDataMiddleware(None, {}, **kwargs)
+
+
 def test_get_file_loader():
     app = SharedDataMiddleware(None, {})
     assert callable(app.get_file_loader("foo"))
