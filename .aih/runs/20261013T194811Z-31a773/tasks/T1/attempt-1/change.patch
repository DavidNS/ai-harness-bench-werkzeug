+        .. versionadded:: 3.2
+        """
+        if self.etag is not None:
+            if isinstance(etag, ETag):
+                if etag.weak:
+                    return False
+
+                etag = etag.value
+
+            return etag == self.etag
+
+        if self.date is not None:
+            return (
+                last_modified is not None
+                and last_modified.replace(microsecond=0) == self.date
+            )
+
+        return False
+
