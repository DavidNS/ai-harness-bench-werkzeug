+        assert rv.status_code == 206
+        assert rv.headers["Accept-Ranges"] == "bytes"
+        assert rv.headers["Content-Range"] == f"bytes 0-3/{len(expect)}"
+        assert rv.content_length == 4
+        assert b"".join(rv.response) == expect[:4]
